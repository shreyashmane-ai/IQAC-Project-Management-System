# IQAC PMS - Environment Configuration
# Copy this to .env and modify values

# Django
SECRET_KEY=your-super-secret-key-change-in-production-min-50-chars
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.edu

# Database - MySQL 8.0+
DB_ENGINE=mysql

# MySQL Configuration
DB_NAME=iqac_pms
DB_USER=iqac_user
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=3306

# Redis - single instance, separate logical databases:
#   db 0 = Celery broker, db 1 = Celery results, db 2 = cache + throttling
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
REDIS_URL=redis://localhost:6379/2

# File Storage - S3/MinIO
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_STORAGE_BUCKET_NAME=iqac-pms
AWS_S3_ENDPOINT_URL=http://localhost:9000  # For MinIO; leave empty for AWS S3
AWS_S3_REGION_NAME=us-east-1

# Email (SendGrid example)
SENDGRID_API_KEY=your-sendgrid-api-key
DEFAULT_FROM_EMAIL=IQAC PMS <noreply@university.edu>

# Frontend URL (for certificate verification links)
FRONTEND_URL=http://localhost:3000

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Security (production)
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True